# Public site URL, used for canonical + OG tags
NEXT_PUBLIC_SITE_URL=https://microns.studio

# Cal.com or Calendly link embedded on /book. Unset = email fallback is shown.
NEXT_PUBLIC_BOOKING_URL=

# Plausible domain. Unset = no analytics script is loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Server-side only. Where the /audit form is forwarded (n8n webhook).
# Unset = submissions are logged to the server console instead.
AUDIT_WEBHOOK_URL=
