# Microns control panel — example environment.
#
# Copy to .env for local development. Never commit the real file: MASTER_KEY
# unwraps every clinic's encryption key, and those keys decrypt patient records.

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated. In production, name the real host rather than leaving "*".
CORS_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=*

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://microns:password@localhost:5432/microns_control

# --- Crypto ----------------------------------------------------------------
# Generate with: python -m app.cli gen-key
# The control panel refuses to start in production without this.
MASTER_KEY=generate-with-python-m-app-cli-gen-key
# Previous keys, newest first, so a rotation can unseal what it has not yet
# rewritten. Comma-separated.
MASTER_KEYS_OLD=

# Signs session cookies. Rotating it signs everybody out, which is the right
# response to suspecting it leaked.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Railway (provisioning target) -----------------------------------------
# A token with permission to create projects in the workspace below.
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=
# Where a clinic's engine is deployed from.
ENGINE_REPO=thevedantpawar/my-first-project
ENGINE_BRANCH=main
ENGINE_ROOT_DIRECTORY=microns-ai-system/backend

# --- Stripe ----------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_TRIAL_DAYS=14

# --- Defaults pushed to a newly provisioned clinic -------------------------
# "none" is the deterministic rule engine. Neither vendor is BAA-covered until
# you arrange it, so a clinic does not start sending prompts to an uncovered
# endpoint on day one.
DEFAULT_LLM_PROVIDER=none
DEFAULT_OPENAI_API_KEY=
DEFAULT_GEMINI_API_KEY=

# Whether anyone who reaches the sign-up page may create an account. Off,
# because this service holds the sealed copy of every clinic's encryption key
# and is not a self-serve product. Turn it on deliberately if it becomes one.
# The very first account is allowed regardless, so a fresh deployment can always
# be bootstrapped.
ALLOW_PUBLIC_SIGNUP=false
