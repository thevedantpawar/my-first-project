# ---------------------------------------------------------------------------
# Microns LinkedIn content agent
# LinkedIn only. There are deliberately no Twitter/X credentials here, and no
# credentials for comment automation or DM automation — the system does not
# implement those features.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001

# --- Gemini (content generation) -------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Only used when image generation is enabled. Leave as-is unless you know you
# have access to a different image model.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Tavily (current research) ---------------------------------------------
TAVILY_API_KEY=
CONTENT_RESEARCH_QUERY=AI agents automation Claude Gemini OpenAI agentic workflows B2B automation news

# --- LinkedIn (publishing) -------------------------------------------------
# Member access token with w_member_social. LINKEDIN_PERSON_URN must start
# with "urn:li:person:".
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
# LinkedIn versioned API header (YYYYMM). Bump when LinkedIn retires a version.
LINKEDIN_API_VERSION=202506
# Image upload is implemented but off by default. With this false the workflow
# publishes text-only and records the image as prepared-but-not-attached.
LINKEDIN_ENABLE_IMAGE_UPLOAD=false

# --- Google Sheets (run logging) -------------------------------------------
# The spreadsheet id from its URL. The "published" and "blocked" tabs are
# created automatically on first write.
GOOGLE_SHEETS_ID=
# Preferred: an OAuth client plus a refresh token. This is the only option that
# survives an unattended daily run — a Google access token lasts about an hour.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
# Fallback for a quick manual test only. Expires within the hour.
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_PUBLISHED_SHEET=published
GOOGLE_SHEETS_BLOCKED_SHEET=blocked

# --- Scheduler --------------------------------------------------------------
# Monday-Friday only, Asia/Kolkata.
SOCIAL_CONTENT_SCHEDULER_ENABLED=false
SOCIAL_CONTENT_RUN_HOUR=21
SOCIAL_CONTENT_RUN_MINUTE=0
SOCIAL_CONTENT_DRY_RUN=true

# --- Content limits ---------------------------------------------------------
CONTENT_MIN_WORDS=150
CONTENT_MAX_WORDS=220

# --- Conversion destinations ------------------------------------------------
# Only real, publicly reachable URLs. A CTA that points at one of these is
# blocked when the matching URL is empty, so the agent can never promise a
# resource that does not exist.
PROFILE_URL=
PUBLIC_RESOURCE_URL=
CASE_STUDY_URL=
CALENDAR_URL=

# --- Local state ------------------------------------------------------------
# Run log, authenticity pack, swipe file and analytics are stored here as JSON.
DATA_DIR=./data
