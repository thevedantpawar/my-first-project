# =============================================================================
# Microns Dental Native — environment configuration
#
#   cp .env.example .env
#   docker compose run --rm backend python -m app.cli gen-key   # ENCRYPTION_KEY etc.
#   # place your Google OAuth client secret at ./credentials.json (see README)
#   docker compose run --rm backend python -m app.cli google-auth
#   docker compose up
#
# NEVER commit a real .env, credentials.json, or token.json. Together they are
# what an attacker needs to decrypt PHI and act as this practice's Google
# identity.
# =============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://microns:password@postgres:5432/microns_dental_db
POSTGRES_USER=microns
POSTGRES_PASSWORD=password
POSTGRES_DB=microns_dental_db

# 32-byte urlsafe-base64 Fernet key. Generate with either:
#   docker compose run --rm backend python -m app.cli gen-key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means losing every encrypted PHI field. Back it up in a
# secrets manager (AWS Secrets Manager / Vault), never in git.
ENCRYPTION_KEY=generate-with-fernet-key-gen

# Comma-separated retired keys. Decrypt-only, used for zero-downtime key
# rotation: put the new key in ENCRYPTION_KEY, move the old one here.
ENCRYPTION_KEYS_OLD=

# Separate secret used to build deterministic lookup fingerprints (HMAC-SHA256)
# for phone/email, so records can be found without decrypting the whole table.
FINGERPRINT_SECRET=change-me-to-a-long-random-string

# Shared secret n8n / a cron job uses to call internal backend endpoints.
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# Shared secret for front-desk/dentist-facing endpoints (recall dashboard,
# treatment-plan list). Sent as the X-Staff-Token header. Replace with your
# IdP in a multi-user deployment so the audit trail attributes access to a
# real person.
STAFF_API_TOKEN=

# --- OpenAI -------------------------------------------------------------------
# BAA REQUIRED. Before any PHI-adjacent traffic: sign a Business Associate
# Agreement with OpenAI and have Zero Data Retention enabled on the org
# (support@openai.com). ZDR endpoints do not persist prompts or completions.
# Independently of ZDR, every prompt this system sends is de-identified first
# (app/services/deidentify.py) — belt and braces.
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_ZERO_RETENTION=true

# --- Twilio -------------------------------------------------------------------
# BAA REQUIRED for SMS that contains appointment details. Twilio signs a BAA
# for Programmable SMS/Voice; enable it before go-live and keep message bodies
# minimal (no diagnoses, no treatment details).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
TWILIO_VALIDATE_SIGNATURE=true
# Allow SMS copy to name the treatment ("your root canal appointment"). Off by
# default: texts appear on lock screens. Turn on only with dentist sign-off.
SMS_INCLUDE_TREATMENT_DETAILS=false

# --- VAPI (voice agent) -------------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Number the agent transfers to for anything it must not answer.
ON_CALL_TRANSFER_NUMBER=+1...

# --- Calendly (emergency + new-patient auto-booking) --------------------------
CALENDLY_API_KEY=
CALENDLY_EMERGENCY_EVENT_TYPE_URI=
CALENDLY_NEW_PATIENT_EVENT_TYPE_URI=
CALENDLY_SCHEDULING_URL=https://calendly.com/your-practice/new-patient-exam

# --- Google Workspace (Calendar / Contacts / Gmail / Drive) -------------------
# HIPAA note: Google Workspace Business Plus or Enterprise is required for a
# BAA covering these APIs. See the README's Google Cloud setup section for the
# full OAuth walkthrough.
GOOGLE_CREDENTIALS_PATH=/app/credentials.json
GOOGLE_TOKEN_PATH=/app/token.json
GOOGLE_PRIMARY_CALENDAR_ID=primary
GOOGLE_RECALL_TRACKING_CALENDAR_ID=your-recall-calendar-id@group.calendar.google.com
GOOGLE_TREATMENT_PLAN_CALENDAR_ID=your-tp-calendar-id@group.calendar.google.com
GOOGLE_ON_CALL_CALENDAR_ID=your-on-call-calendar-id@group.calendar.google.com
GOOGLE_FRONT_DESK_CALENDAR_ID=your-front-desk-calendar-id@group.calendar.google.com
GOOGLE_DRIVE_FOLDER_ID=
# accounts/<id>/locations/<id> — see README's Business Profile section.
GOOGLE_BUSINESS_PROFILE_LOCATION=

# Where AI-drafted messages go for a human to approve (forward/reply to send).
DENTIST_APPROVAL_EMAIL=
FRONT_DESK_EMAIL=
INSURANCE_COORDINATOR_EMAIL=
ON_CALL_DENTIST_EMAIL=

# --- n8n ------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_HOST=localhost
N8N_PORT=5678
# Only used if you wire the n8n-workflows/*.json to call this backend — they
# are self-contained by default (see n8n-workflows/README.md).
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook

# --- Practice profile (used in SMS copy and voice prompts) --------------------
PRACTICE_NAME=Microns Dental
PRACTICE_TIMEZONE=America/New_York
PRACTICE_PHONE=+1...
PRACTICE_ADDRESS=
PRACTICE_BOOKING_URL=https://your-practice.com/book
PRACTICE_GOOGLE_REVIEW_URL=https://g.page/r/your-google-review-link/review
PRACTICE_OPEN_HOUR=8
PRACTICE_CLOSE_HOUR_MON_THU=17
PRACTICE_CLOSE_HOUR_FRI=14

# --- Retention tuning ----------------------------------------------------
HYGIENE_RECALL_DAYS=180
REVIEW_REQUEST_DELAY_DAYS=1
REVIEW_RECHECK_DAYS=5

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call /leads/chat from the browser widget.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated hostnames the API will answer to in production.
ALLOWED_HOSTS=*
REDIS_URL=redis://redis:6379/0
