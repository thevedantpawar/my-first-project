    {"id":"012e8272-8eb2-48e3-8736-0cd9bf5b5ff7","name":"Get Next Emergency Slot (Calendly)","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1344,704],"parameters":{"method":"GET","url":"<__PLACEHOLDER_VALUE__Calendly API URL for next available emergency slot, e.g. https://api.calendly.com/event_types/EMERGENCY_TYPE/available_times__>","authentication":"genericCredentialType","genericAuthType":"httpTemplatedCustomAuth","sendQuery":true,"specifyQuery":"keypair","queryParameters":{"parameters":[{"name":"start_time","value":"={{ $now.toISO() }}"},{"name":"end_time","value":"={{ $now.plus({ days: 2 }).toISO() }}"}]}}},
    {"id":"56cebddb-e3a7-46d2-a1fa-b023e05a133b","name":"Parse Emergency Slot","type":"n8n-nodes-base.code","typeVersion":2,"position":[1568,704],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const resp = $json; const slots = resp.collection || resp.available_times || []; const first = slots[0] || {}; const startTime = first.start_time || first.startTime || ''; const bookingUrl = first.scheduling_url || first.schedulingUrl || ''; const slotTimeEnd = startTime ? new Date(new Date(startTime).getTime() + 60*60*1000).toISOString() : ''; return [{ json: { slotTime: startTime, slotTimeEnd: slotTimeEnd, bookingUrl: bookingUrl } }];"}},
