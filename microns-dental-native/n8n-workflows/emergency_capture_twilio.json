    {"id":"d4e8c834-acfe-4ae0-bc9c-5d459477e855","name":"Notify On-Call Dentist (URGENT)","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1344,512],"parameters":{"resource":"message","operation":"send","sendTo":"<__PLACEHOLDER_VALUE__On-call dentist email address for urgent escalations__>","subject":"={{ '\\uD83D\\uDEA8 EMERGENCY CALLBACK: ' + $json.patientName + ' | ' + $json.phone }}","message":"={{ 'URGENT dental emergency. Patient: ' + $json.patientName + '. Phone: ' + $json.phone + '. Replied URGENT to the missed-call text. Please call back within 15 minutes.' }}"},"webhookId":"384347cc-20b3-45d9-8ce4-649d809eef12"},
