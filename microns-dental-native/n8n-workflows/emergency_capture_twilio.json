    {"id":"ec3cfbc2-f3ca-4e3a-82fa-63210ddc42d2","name":"Voice Call Summary Trigger","type":"n8n-nodes-base.twilioTrigger","typeVersion":1,"position":[0,192],"parameters":{"updates":["com.twilio.voice.insights.call-summary.complete"]},"webhookId":"ef669111-771a-4069-a055-bc5e7a6420d1"},
    {"id":"65fa5546-db93-4347-9021-36b44fdc6631","name":"Detect After-Hours Missed Call","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,192],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const body = $json; const callerPhone = body.from || body.From || body.caller || ''; const status = ((body.callState || body.CallStatus || body.status || '') + '').toLowerCase(); const duration = Number(body.duration || body.CallDuration || 0); const missed = status.indexOf('no-answer') > -1 || status.indexOf('busy') > -1 || status.indexOf('failed') > -1 || duration === 0; const now = new Date(); const day = now.getDay(); const hour = now.getHours(); let afterHours = false; if (day === 0 || day === 6) { afterHours = true; } else if (day >= 1 && day <= 4) { afterHours = hour >= 17 || hour < 8; } else if (day === 5) { afterHours = hour >= 14 || hour < 8; } return [{ json: { callerPhone: callerPhone, missed: missed, afterHours: afterHours, isEmergencyCandidate: missed && afterHours } }];"}},
