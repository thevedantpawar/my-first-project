    {"id":"d42070e6-d183-47e1-b78d-6d256ceb0c6d","name":"Parse Inbound Reply","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,912],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const body = $json; const fromPhone = body.from || body.From || ''; const text = ((body.body || body.Body || '') + '').trim().toUpperCase(); let keyword = 'OTHER'; if (text.indexOf('URGENT') > -1) { keyword = 'URGENT'; } else if (text.indexOf('BOOK') > -1) { keyword = 'BOOK'; } else if (text.indexOf('INFO') > -1) { keyword = 'INFO'; } return [{ json: { fromPhone: fromPhone, keyword: keyword } }];"}},
