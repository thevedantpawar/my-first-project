    {"id":"cbc1b79d-1d44-41e7-9210-1dbea441cc5e","name":"Check Existing Patient","type":"n8n-nodes-base.code","typeVersion":2,"position":[896,96],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const contact = $input.first().json; const callerPhone = $('Detect After-Hours Missed Call').first().json.callerPhone; const found = !!(contact && contact.contactId); const patientName = (found && contact.names && contact.names.displayName) ? contact.names.displayName : ''; return [{ json: { patientFound: found, patientName: patientName, callerPhone: callerPhone } }];"}},
