    {"id":"6796b053-5cf1-4448-b1a0-a45ccba5d022","name":"Get New Patient Exam Slots (Calendly)","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[1584,0],"parameters":{"method":"GET","url":"<__PLACEHOLDER_VALUE__Calendly API URL for next available new-patient exam slots, e.g. https://api.calendly.com/event_types/NEW_PATIENT_TYPE/available_times__>","authentication":"genericCredentialType","genericAuthType":"httpTemplatedCustomAuth","sendQuery":true,"specifyQuery":"keypair","queryParameters":{"parameters":[{"name":"start_time","value":"={{ $now.toISO() }}"},{"name":"end_time","value":"={{ $now.plus({ days: 7 }).toISO() }}"}]}}},
    {"id":"9fd714c1-37a0-448c-b53a-254ebc42cf33","name":"Parse New Patient Slots","type":"n8n-nodes-base.code","typeVersion":2,"position":[1808,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const resp = $json; const slots = resp.collection || resp.available_times || []; const s0 = slots[0] || {}; const s1 = slots[1] || {}; const s2 = slots[2] || {}; const start0 = s0.start_time || s0.startTime || ''; const start0End = start0 ? new Date(new Date(start0).getTime() + 60*60*1000).toISOString() : ''; const bookingUrl = s0.scheduling_url || s0.schedulingUrl || ''; return [{ json: { slot1: start0, slot1End: start0End, slot2: s1.start_time || s1.startTime || '', slot3: s2.start_time || s2.startTime || '', bookingUrl: bookingUrl } }];"}},
