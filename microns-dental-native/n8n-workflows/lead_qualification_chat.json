  "name": "Lead Qualification (Chat + SMS)",
  "nodes": [
    {"id":"f73e3f06-900c-4dc2-9d58-ad9d4b7e5b2d","name":"Lead Chat Webhook","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,304],"parameters":{"httpMethod":"POST","path":"lead-chat","responseMode":"responseNode"},"webhookId":"7f0f8a7b-dc45-443d-bab6-b7fa8267dfef"},
    {"id":"423d1b8d-180a-4d8c-a8a9-bd59e07a7c89","name":"Normalize Chat Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,400],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const j = $json; const isWebhook = !!(j.body && typeof j.body === 'object'); let message = ''; let sessionId = ''; let phone = ''; let respondVia = 'sms'; if (isWebhook) { message = j.body.message || ''; phone = j.body.phone || ''; sessionId = j.body.sessionId || ('web_' + Date.now()); respondVia = 'webhook'; } else { message = j.body || j.Body || ''; phone = j.from || j.From || ''; sessionId = 'sms_' + phone; respondVia = 'sms'; } return [{ json: { message: message, sessionId: sessionId, phone: phone, respondVia: respondVia } }];"}},
    {"id":"cb8aa1ee-4767-4aea-9998-25e00415aa13","name":"Lead Qualification Agent","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[512,400],"parameters":{"promptType":"define","text":"={{ $json.message }}","hasOutputParser":true,"options":{"systemMessage":"You are a friendly front-desk assistant for a dental practice, qualifying a new lead over chat/SMS. Ask ONE question at a time, in this order, waiting for the answer before asking the next: (1) What treatment are they most interested in (Cleaning, Emergency, Invisalign, Implants, Whitening, Veneers, Other), (2) When was their last dental visit (Within 6 months, 1-2 years, 2+ years, Never), (3) Do they have dental insurance (Yes-PPO, Yes-HMO, Yes-Medicaid, No, Not sure), (4) Are they experiencing pain or an emergency right now (Yes-severe, Yes-moderate, No), (5) When are they looking to be seen (Today, This week, Within 2 weeks, Just browsing), (6) Their name and preferred phone number. Once ALL SIX are collected, set done=true and compute score 0-100: severe pain or today/this-week timeline should push the score to 80-100 (HOT); moderate signals with within-2-weeks timeline land 50-79 (WARM); no urgency or just browsing lands 0-49 (COLD). Always respond with ONLY the JSON object matching the schema -- reply should hold your next conversational message to the lead (empty string once done)."}}},
    {"id":"7832381c-2771-4921-8f48-3508888883fb","name":"OpenAI Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[448,624],"parameters":{}},
    {"id":"016d4921-f09e-4aba-a545-635c2f570a01","name":"Lead Chat Memory","type":"@n8n/n8n-nodes-langchain.memoryBufferWindow","typeVersion":1.3,"position":[576,624],"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Normalize Chat Input').item.json.sessionId }}","contextWindowLength":12}},
