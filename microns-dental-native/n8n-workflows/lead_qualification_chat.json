    {"id":"adeef573-ad3e-40a1-a89d-088b51024158","name":"Score Tier","type":"n8n-nodes-base.code","typeVersion":2,"position":[1136,96],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const o = $json.output; const score = Number(o.score) || 0; let tier = 'COLD'; if (score >= 80) { tier = 'HOT'; } else if (score >= 50) { tier = 'WARM'; } const result = Object.assign({}, o, { tier: tier }); return [{ json: result }];"}},
