{
  "name": "Insurance Verification Assistant (Gmail)",
  "nodes": [
    {"id":"11604363-eb97-42b6-a6d9-12198da51d4f","name":"Daily 4PM Insurance Check","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.4,"position":[0,80],"parameters":{"rule":{"interval":[{"field":"days","triggerAtHour":16,"triggerAtMinute":0}]}}},
    {"id":"a28bccf8-4813-4688-8cf2-526d6132d217","name":"Get Tomorrow's Appointments","type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[224,80],"parameters":{"resource":"event","operation":"getAll","calendar":{"__rl":true,"mode":"id","value":"<__PLACEHOLDER_VALUE__Practice \"Appointments\" Google Calendar ID__>"},"returnAll":true,"timeMin":"={{ $today.plus({ days: 1 }).toISO() }}","timeMax":"={{ $today.plus({ days: 2 }).toISO() }}"}},
    {"id":"0fa7d9af-fcfa-4ee2-90ea-813325bce6a6","name":"Filter New Patient Appts With Insurance","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,80],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const items = $input.all(); const results = []; for (const item of items) { const description = item.json.description || ''; const lines = description.split('\\n'); const map = {}; for (const line of lines) { const idx = line.indexOf(':'); if (idx > -1) { const key = line.slice(0, idx).trim().toUpperCase(); const val = line.slice(idx + 1).trim(); map[key] = val; } } const service = (map['SERVICE'] || '').toLowerCase(); const isNewPatient = service.indexOf('new patient') > -1; const insurance = map['INSURANCE'] || ''; if (isNewPatient && insurance) { const apptDate = (item.json.start && (item.json.start.dateTime || item.json.start.date)) || ''; results.push({ patientId: map['PATIENT_ID'] || '', patientName: map['PATIENT'] || '', phone: map['PHONE'] || '', insuranceProvider: insurance, memberId: map['MEMBER_ID'] || '', apptDate: apptDate, apptEventId: item.json.id, originalDescription: description }); } } return results.map(function (r) { return { json: r }; });"}},
    {"id":"bbebc229-2094-473c-9cc7-147de4827d6b","name":"Log Pending Verification","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[896,0],"parameters":{"resource":"row","operation":"insert","dataTableId":{"__rl":true,"mode":"id","value":"ZzFIcVRdKgvMIRFT"},"columns":{"mappingMode":"defineBelow","value":{"patientId":"={{ $json.patientId }}","patientName":"={{ $json.patientName }}","phone":"={{ $json.phone }}","insuranceProvider":"={{ $json.insuranceProvider }}","memberId":"={{ $json.memberId }}","apptDate":"={{ $json.apptDate }}","apptEventId":"={{ $json.apptEventId }}","status":"pending","copay":0,"annualMaxRemaining":0,"originalDescription":"={{ $json.originalDescription }}","deductibleMet":"","waitingPeriods":""},"schema":[{"id":"patientId","displayName":"patientId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"patientName","displayName":"patientName","type":"string","canBeUsedToMatch":true,"display":true},{"id":"phone","displayName":"phone","type":"string","canBeUsedToMatch":true,"display":true},{"id":"insuranceProvider","displayName":"insuranceProvider","type":"string","canBeUsedToMatch":true,"display":true},{"id":"memberId","displayName":"memberId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"apptDate","displayName":"apptDate","type":"string","canBeUsedToMatch":true,"display":true},{"id":"apptEventId","displayName":"apptEventId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"status","displayName":"status","type":"string","canBeUsedToMatch":true,"display":true},{"id":"copay","displayName":"copay","type":"number","canBeUsedToMatch":true,"display":true},{"id":"annualMaxRemaining","displayName":"annualMaxRemaining","type":"number","canBeUsedToMatch":true,"display":true},{"id":"originalDescription","displayName":"originalDescription","type":"string","canBeUsedToMatch":true,"display":true},{"id":"deductibleMet","displayName":"deductibleMet","type":"string","canBeUsedToMatch":true,"display":true},{"id":"waitingPeriods","displayName":"waitingPeriods","type":"string","canBeUsedToMatch":true,"display":true}]}}},
    {"id":"8d07946f-8995-40fd-99d1-d434c2455081","name":"Draft Insurance Verification Request","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1120,80],"parameters":{"resource":"draft","operation":"create","subject":"={{ '[VERIFY-' + $json.id + '] VERIFY: ' + $('Process Each New Patient Appt').item.json.patientName + ' | ' + $('Process Each New Patient Appt').item.json.insuranceProvider + ' | Member ID: ' + $('Process Each New Patient Appt').item.json.memberId + ' | Appt: ' + $('Process Each New Patient Appt').item.json.apptDate }}","message":"={{ 'Please verify benefits for tomorrows new patient appointment:\\n\\nPatient: ' + $('Process Each New Patient Appt').item.json.patientName + '\\nInsurance: ' + $('Process Each New Patient Appt').item.json.insuranceProvider + '\\nMember ID: ' + $('Process Each New Patient Appt').item.json.memberId + '\\nAppointment: ' + $('Process Each New Patient Appt').item.json.apptDate + '\\n\\nPlease verify:\\n- Annual maximum remaining\\n- Deductible met (Y/N) and amount remaining\\n- D0120 (Periodic Oral Evaluation) % coverage\\n- D1110 (Prophylaxis - Adult) % coverage\\n- D4341 (Scaling & Root Planing) % coverage\\n- D2740 (Crown - Porcelain/Ceramic) % coverage\\n- Waiting periods for major services (Y/N)\\n- Estimated copay for this visit\\n\\nPlease reply to this email with the verification results by 6:00 PM today.' }}","options":{"sendTo":"<__PLACEHOLDER_VALUE__Insurance coordinator email address__>"}},"webhookId":"567802eb-9312-42d9-bf5b-71329e85fa63"},
    {"id":"aded40c8-a6d0-4d6b-8e6f-3f2415d84f81","name":"Process Each New Patient Appt","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[672,80],"parameters":{"batchSize":1}},
    {"id":"263f8a9c-079e-4157-8753-b3ea1f2fef14","name":"Sticky Note 5971f2a3","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[784,704],"parameters":{"content":"## Insurance Verification Assistant\n\"New patient\" is detected heuristically from SERVICE containing \"New Patient\" in the calendar description -- adjust the check in \"Filter New Patient Appts With Insurance\" if your practice tags new patients differently (the spec's stricter \"no visit in the last 2 years\" check needs patient-history data this Google-Calendar-only workflow does not have).","color":5}},
    {"id":"a0b64a54-bb23-4cbb-8b77-48a0a8f4983b","name":"Verification Reply Trigger","type":"n8n-nodes-base.gmailTrigger","typeVersion":1.4,"position":[0,544],"parameters":{"simple":false,"filters":{"q":"subject:\"[VERIFY-\"","readStatus":"both"}}},
    {"id":"c483960b-a245-4a43-a9b9-04a3c7f507c9","name":"Parse Verification Subject","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,544],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const subject = $json.subject || ''; const startTag = '[VERIFY-'; const endTag = ']'; const startIdx = subject.indexOf(startTag); const endIdx = subject.indexOf(endTag, startIdx); const rowId = (startIdx > -1 && endIdx > -1) ? subject.slice(startIdx + startTag.length, endIdx) : ''; const replyText = $json.text || $json.snippet || ''; return [{ json: { rowId: rowId, replyText: replyText } }];"}},
    {"id":"c9a37591-2c90-4130-8cb2-dc20fa13a77d","name":"Get Verification Row","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[448,544],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"ZzFIcVRdKgvMIRFT"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"id","condition":"eq","keyValue":"={{ Number($('Parse Verification Subject').item.json.rowId) }}"}]},"returnAll":false,"limit":1}},
    {"id":"e59c0073-4b5b-4feb-a6b7-b53b60758ea9","name":"Still Pending Verification?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[672,544],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.status }}","operator":{"type":"string","operation":"equals"},"rightValue":"pending"}],"combinator":"and"}}},
    {"id":"18055deb-adab-45cf-ba94-042d00b188c2","name":"Parse Verification Reply","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[896,304],"parameters":{"promptType":"define","text":"={{ $('Parse Verification Subject').item.json.replyText }}","hasOutputParser":true,"options":{"systemMessage":"Extract structured insurance verification data from the insurance coordinators email reply. Return annualMaxRemaining and copayEstimate as plain numbers (no $ sign), deductibleMet and waitingPeriods as short text summaries. If a field is not mentioned, use 0 for numbers and \"not specified\" for text."}}},
    {"id":"da258eca-5fdd-4e9c-bf91-b7af28b447c7","name":"OpenAI Model","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.3,"position":[912,528],"parameters":{}},
    {"id":"1f1748b6-6da1-4c1e-82d6-aa5f4d5de04d","name":"Verification Output Parser","type":"@n8n/n8n-nodes-langchain.outputParserStructured","typeVersion":1.3,"position":[1040,528],"parameters":{"schemaType":"fromJson","jsonSchemaExample":"{ \"annualMaxRemaining\": 1200, \"deductibleMet\": \"yes, $50 remaining\", \"waitingPeriods\": \"none\", \"copayEstimate\": 45 }"}},
    {"id":"f0029e03-1754-439d-8e1b-a8018d25198e","name":"Save Verification Result","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1248,400],"parameters":{"resource":"row","operation":"update","dataTableId":{"__rl":true,"mode":"id","value":"ZzFIcVRdKgvMIRFT"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"id","condition":"eq","keyValue":"={{ $('Get Verification Row').item.json.id }}"}]},"columns":{"mappingMode":"defineBelow","value":{"status":"verified","copay":"={{ $json.output.copayEstimate }}","annualMaxRemaining":"={{ $json.output.annualMaxRemaining }}","deductibleMet":"={{ $json.output.deductibleMet }}","waitingPeriods":"={{ $json.output.waitingPeriods }}"},"schema":[{"id":"patientId","displayName":"patientId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"patientName","displayName":"patientName","type":"string","canBeUsedToMatch":true,"display":true},{"id":"phone","displayName":"phone","type":"string","canBeUsedToMatch":true,"display":true},{"id":"insuranceProvider","displayName":"insuranceProvider","type":"string","canBeUsedToMatch":true,"display":true},{"id":"memberId","displayName":"memberId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"apptDate","displayName":"apptDate","type":"string","canBeUsedToMatch":true,"display":true},{"id":"apptEventId","displayName":"apptEventId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"status","displayName":"status","type":"string","canBeUsedToMatch":true,"display":true},{"id":"copay","displayName":"copay","type":"number","canBeUsedToMatch":true,"display":true},{"id":"annualMaxRemaining","displayName":"annualMaxRemaining","type":"number","canBeUsedToMatch":true,"display":true},{"id":"originalDescription","displayName":"originalDescription","type":"string","canBeUsedToMatch":true,"display":true},{"id":"deductibleMet","displayName":"deductibleMet","type":"string","canBeUsedToMatch":true,"display":true},{"id":"waitingPeriods","displayName":"waitingPeriods","type":"string","canBeUsedToMatch":true,"display":true}]}}},
    {"id":"c815b892-7853-4e9b-8c4a-e34b3d19b377","name":"Notify Patient Verified","type":"n8n-nodes-base.twilio","typeVersion":1,"position":[1472,400],"parameters":{"resource":"sms","operation":"send","from":"<__PLACEHOLDER_VALUE__Practice Twilio phone number, e.g. +15551234567__>","to":"={{ $('Get Verification Row').item.json.phone }}","message":"={{ 'Hi ' + $('Get Verification Row').item.json.patientName + \", we've verified your \" + $('Get Verification Row').item.json.insuranceProvider + ' benefits! Your estimated copay for tomorrows visit is $' + $('Parse Verification Reply').item.json.output.copayEstimate + '. See you then!' }}"}},
    {"id":"38338ea1-77e8-4874-b44e-bdf07d7d353b","name":"Update Appointment With Verification","type":"n8n-nodes-base.googleCalendar","typeVersion":1.3,"position":[1696,400],"parameters":{"resource":"event","operation":"update","calendar":{"__rl":true,"mode":"id","value":"<__PLACEHOLDER_VALUE__Practice \"Appointments\" Google Calendar ID__>"},"eventId":"={{ $('Get Verification Row').item.json.apptEventId }}","updateFields":{"description":"={{ $('Get Verification Row').item.json.originalDescription + '\\nVERIFIED: Copay $' + $('Parse Verification Reply').item.json.output.copayEstimate + ' | Annual Max Remaining: $' + $('Parse Verification Reply').item.json.output.annualMaxRemaining }}"}}},
    {"id":"50ba9b85-0587-49c0-a696-c545f1e6215f","name":"Verification Already Processed - No Action","type":"n8n-nodes-base.set","typeVersion":3.5,"position":[960,704],"parameters":{"mode":"manual","includeOtherFields":true,"assignments":{"assignments":[{"id":"a1","name":"note","value":"stale_or_already_verified","type":"string"}]}}},
    {"id":"11b1a896-78d0-4125-a8da-86918385f1ea","name":"Sticky Note cca1f853","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[784,960],"parameters":{"content":"## Coordinator Reply Handling\nThe insurance coordinator replies directly to the \"[VERIFY-<rowId>]\" draft (forward the draft as a real email first -- Gmail drafts must be sent by a human, n8n only creates the draft per the HIPAA note that these should originate from the Microns AI service account). An AI agent with a structured output parser extracts annual max, deductible, waiting periods, and estimated copay from the free-text reply, then the patient is texted and the calendar event description is updated.","color":5}}
