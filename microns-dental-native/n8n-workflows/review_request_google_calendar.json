    {"id":"cea5294f-3ca1-4f20-8250-32b55aeb43ba","name":"Get Recent Google Reviews","type":"n8n-nodes-base.googleBusinessProfile","typeVersion":1,"position":[896,416],"parameters":{"resource":"review","operation":"getAll","account":{"__rl":true,"mode":"name","value":"<__PLACEHOLDER_VALUE__Google Business Profile account name (e.g. accounts/1234567890)__>"},"location":{"__rl":true,"mode":"name","value":"<__PLACEHOLDER_VALUE__Google Business Profile location name (e.g. accounts/123/locations/456)__>"},"returnAll":false,"limit":20},"alwaysOutputData":true},
    {"id":"8ef51de9-b91b-4a10-9980-8c4b29dd979c","name":"Match Review To Patient","type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,416],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const rowData = $('Process Each Review Row').first().json; const patientNameLower = (rowData.patientName || '').toLowerCase(); const nameFirstToken = patientNameLower.split(' ')[0]; const apptTime = new Date(rowData.apptDate).getTime(); const reviews = $input.all(); let match = null; for (const item of reviews) { const r = item.json; const reviewerName = ((r.reviewer && r.reviewer.displayName) || '').toLowerCase(); const created = r.createTime ? new Date(r.createTime).getTime() : 0; const alreadyReplied = !!(r.reviewReply && r.reviewReply.comment); if (!alreadyReplied && nameFirstToken && reviewerName.indexOf(nameFirstToken) > -1 && created >= apptTime) { match = r; break; } } if (match) { return [{ json: { matched: true, reviewId: match.reviewId || match.name || '', comment: match.comment || '', starRating: match.starRating || '' } }]; } return [{ json: { matched: false, reviewId: '', comment: '', starRating: '' } }];"}},
    {"id":"c4a10ad1-6b2b-4019-9bcb-3c44bdfee158","name":"Matching Review Found?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1344,512],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.matched }}","operator":{"type":"boolean","operation":"equals"},"rightValue":true}],"combinator":"and"}}},
    {"id":"eecbc183-e49a-4fd5-9e1b-9ea3ce694b46","name":"Generate Review Reply","type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[1568,320],"parameters":{"promptType":"define","text":"={{ 'Patient (reviewer) name: ' + $('Process Each Review Row').item.json.patientName + '. Star rating: ' + $json.starRating + '. Review text: \\\"' + $json.comment + '\\\". Write the reply.' }}","options":{"systemMessage":"You draft short, warm, professional owner responses to Google reviews for a dental practice. For 5-star or 4-star reviews: thank them warmly, mention the provider if named in the review, and invite them back. For 3-star or below: be empathetic, do not get defensive, offer to make it right, and ask them to call the office. Keep it under 500 characters, plain text, no quotes around the whole reply. Output ONLY the reply text."}}},
