    {"id":"2d40964f-ccfb-4013-8357-707d57a0223c","name":"Parse Appointment Description","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,0],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const description = $json.description || ''; const lines = description.split('\\n'); const map = {}; for (const line of lines) { const idx = line.indexOf(':'); if (idx > -1) { const key = line.slice(0, idx).trim().toUpperCase(); const val = line.slice(idx + 1).trim(); map[key] = val; } } const apptDate = ($json.end && ($json.end.dateTime || $json.end.date)) || new Date().toISOString(); const firstCheck = new Date(new Date(apptDate).getTime() + 24*60*60*1000).toISOString(); return [{ json: { patientId: map['PATIENT_ID'] || '', patientName: map['PATIENT'] || '', phone: map['PHONE'] || '', email: map['EMAIL'] || '', apptDate: apptDate, sourceEventId: $json.id, firstCheck: firstCheck } }];"}},
