    {"id":"a5dfd24e-847a-4091-bb0a-00d1d99acfd8","name":"Parse Review Approval Subject","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,1184],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const subject = $json.subject || ''; const startTag = '[APPROVE-REVIEW-'; const endTag = ']'; const startIdx = subject.indexOf(startTag); const endIdx = subject.indexOf(endTag, startIdx); const rowId = (startIdx > -1 && endIdx > -1) ? subject.slice(startIdx + startTag.length, endIdx) : ''; return [{ json: { rowId: rowId } }];"}},
