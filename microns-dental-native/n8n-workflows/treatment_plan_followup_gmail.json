    {"id":"90630935-3a45-49d4-b3f8-dec6b6bde708","name":"Compute Next TP Stage","type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,2336],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const dayNum = $('Parse Approval Subject').first().json.dayNum; const now = new Date(); const plans = { '1': { stage: 'DAY3', addDays: 2 }, '3': { stage: 'DAY7', addDays: 4 }, '7': { stage: 'DAY14', addDays: 7 }, '14': { stage: 'DAY30', addDays: 16 }, '30': { stage: 'DAY30_DONE', addDays: 16 } }; const plan = plans[dayNum] || { stage: 'DAY30_DONE', addDays: 16 }; const nextActionDate = new Date(now.getTime() + plan.addDays*24*60*60*1000).toISOString(); return [{ json: { nextStage: plan.stage, nextActionDate: nextActionDate } }];"}},
    {"id":"6757be79-a726-4d5e-addd-de1500b06707","name":"Apply Approved Advance","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[1344,2336],"parameters":{"resource":"row","operation":"update","dataTableId":{"__rl":true,"mode":"id","value":"Eo1AbqElfheoT1tD"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"id","condition":"eq","keyValue":"={{ $('Get TP Row For Approval').item.json.id }}"}]},"columns":{"mappingMode":"defineBelow","value":{"status":"active","stage":"={{ $('Compute Next TP Stage').item.json.nextStage }}","nextActionDate":"={{ $('Compute Next TP Stage').item.json.nextActionDate }}","pendingSmsText":""},"schema":[{"id":"patientId","displayName":"patientId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"patientName","displayName":"patientName","type":"string","canBeUsedToMatch":true,"display":true},{"id":"phone","displayName":"phone","type":"string","canBeUsedToMatch":true,"display":true},{"id":"tpDescription","displayName":"tpDescription","type":"string","canBeUsedToMatch":true,"display":true},{"id":"tpValue","displayName":"tpValue","type":"number","canBeUsedToMatch":true,"display":true},{"id":"presentedDate","displayName":"presentedDate","type":"string","canBeUsedToMatch":true,"display":true},{"id":"stage","displayName":"stage","type":"string","canBeUsedToMatch":true,"display":true},{"id":"nextActionDate","displayName":"nextActionDate","type":"string","canBeUsedToMatch":true,"display":true},{"id":"trackingEventId","displayName":"trackingEventId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"sourceEventId","displayName":"sourceEventId","type":"string","canBeUsedToMatch":true,"display":true},{"id":"status","displayName":"status","type":"string","canBeUsedToMatch":true,"display":true},{"id":"pendingSmsText","displayName":"pendingSmsText","type":"string","canBeUsedToMatch":true,"display":true}]}}},
