    {"id":"c9e3fa8b-1547-40c6-9d1c-7840c7bcee1f","name":"Parse Booking For Conversion","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,2832],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const description = $json.description || ''; const lines = description.split('\\n'); const map = {}; for (const line of lines) { const idx = line.indexOf(':'); if (idx > -1) { const key = line.slice(0, idx).trim().toUpperCase(); const val = line.slice(idx + 1).trim(); map[key] = val; } } return [{ json: { phone: map['PHONE'] || '' } }];"}},
