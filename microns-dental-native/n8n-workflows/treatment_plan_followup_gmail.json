    {"id":"eca2a2c6-cddd-415f-83d7-21d8c1d55c01","name":"Consultation Ended Trigger","type":"n8n-nodes-base.googleCalendarTrigger","typeVersion":1,"position":[0,96],"parameters":{"calendarId":{"__rl":true,"mode":"id","value":"<__PLACEHOLDER_VALUE__Practice \"Consultations / Exams\" Google Calendar ID__>"},"triggerOn":"eventEnded"}},
    {"id":"c46447b6-e166-466d-a76a-cd3a2ab588a6","name":"Parse Consultation Description","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,96],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const description = $json.description || ''; const lines = description.split('\\n'); const map = {}; for (const line of lines) { const idx = line.indexOf(':'); if (idx > -1) { const key = line.slice(0, idx).trim().toUpperCase(); const val = line.slice(idx + 1).trim(); map[key] = val; } } const presented = ($json.end && ($json.end.dateTime || $json.end.date)) || new Date().toISOString(); const tpValueRaw = (map['TP_VALUE'] || '0').replace('$', '').replace(/,/g, ''); const day3Date = new Date(new Date(presented).getTime() + 1*24*60*60*1000).toISOString(); const day3DateEnd = new Date(new Date(day3Date).getTime() + 30*60*1000).toISOString(); const data = { patientId: map['PATIENT_ID'] || '', patientName: map['PATIENT'] || '', phone: map['PHONE'] || '', tpDescription: map['TREATMENT_PLAN'] || '', tpScheduled: (map['TP_SCHEDULED'] || 'NO').toUpperCase(), tpValue: parseFloat(tpValueRaw) || 0, presentedDate: presented, sourceEventId: $json.id, day3Date: day3Date, day3DateEnd: day3DateEnd }; return [{ json: data }];"}},
