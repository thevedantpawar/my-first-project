    {"id":"4da3217a-cbaa-46cc-9f76-f4fd84c59f45","name":"TP Approval Email Trigger","type":"n8n-nodes-base.gmailTrigger","typeVersion":1.4,"position":[0,2432],"parameters":{"simple":true,"filters":{"q":"subject:\"[APPROVE-TP-\"","readStatus":"both"}}},
    {"id":"27b9e32c-e041-4e27-a4fe-4534c67c74c7","name":"Parse Approval Subject","type":"n8n-nodes-base.code","typeVersion":2,"position":[224,2432],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const subject = $json.subject || ''; const startTag = '[APPROVE-TP-'; const dayTag = '-DAY'; const endTag = ']'; const startIdx = subject.indexOf(startTag); const dayIdx = subject.indexOf(dayTag, startIdx); const endIdx = subject.indexOf(endTag, dayIdx); const rowId = (startIdx > -1 && dayIdx > -1) ? subject.slice(startIdx + startTag.length, dayIdx) : ''; const dayNum = (dayIdx > -1 && endIdx > -1) ? subject.slice(dayIdx + dayTag.length, endIdx) : ''; return [{ json: { rowId: rowId, dayNum: dayNum } }];"}},
    {"id":"c42f504c-a496-4ab3-9efe-53002caa8fcf","name":"Get TP Row For Approval","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[448,2432],"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"mode":"id","value":"Eo1AbqElfheoT1tD"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"id","condition":"eq","keyValue":"={{ Number($('Parse Approval Subject').item.json.rowId) }}"}]},"returnAll":false,"limit":1}},
