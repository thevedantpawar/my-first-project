# --- Server ---
PORT=3000
LOG_LEVEL=info

# --- WhatsApp Cloud API (Meta) ---
# Get these from developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Any string you choose; must match what you enter in the Meta webhook config screen
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=
# Name of an approved message template used for proactive refill reminders
# (outside the 24h customer service window, WhatsApp requires a pre-approved template)
WHATSAPP_REMINDER_TEMPLATE_NAME=refill_reminder
WHATSAPP_REMINDER_TEMPLATE_LANG=en

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Storage ---
DB_PATH=./data/app.db
PRODUCT_CATALOG_PATH=./data/products.json
PRESCRIPTION_TERMS_PATH=./data/prescription_terms.json

# --- Refill reminders ---
# Cron expression, default 9am every day
REMINDER_CRON=0 9 * * *
# How many days before/after the computed due date we still send a reminder
REMINDER_WINDOW_DAYS=3
DISABLE_SCHEDULER=false

# --- Human review handoff ---
# none | slack | email  (only "none" is wired to actually send anywhere right now;
# slack/email are stubbed adapters in src/review/notify.js ready to fill in)
HUMAN_REVIEW_NOTIFY_METHOD=none
SLACK_WEBHOOK_URL=
