<section class="featured-collection">
  {%- if section.settings.heading != blank -%}
    <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- assign featured_collection = collections[section.settings.collection] -%}
  <ul class="featured-collection__grid">
    {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
      <li>{%- render 'product-card', product: product -%}</li>
    {%- endfor -%}
  </ul>

  {%- if featured_collection.url -%}
    <a href="{{ featured_collection.url }}" class="featured-collection__view-all">{{ 'general.collection.view_all' | t: default: 'View all' }} →</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
