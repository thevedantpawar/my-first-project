# ---------------------------------------------------------------------------
# Ashirwad Wellness — environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://ashirwad:ashirwad@localhost:5432/ashirwad_wellness?schema=public"

# --- Auth ------------------------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Phone OTP is stubbed behind an interface in Phase 1. With this unset the
# stub provider logs the OTP to the server console instead of sending it.
OTP_PROVIDER="stub"

# --- Regulatory identifiers -------------------------------------------------
# These render in the site footer and on the checkout page, and are stamped
# onto invoices and the Schedule H1 register.
#
# The values below are OBVIOUS PLACEHOLDERS. They are not valid licence
# numbers and are not formatted like real ones, so a half-configured deploy
# fails loudly instead of publishing a plausible-looking fake. Replace every
# one of them with Ashirwad Medical's actual registered details before the
# site is reachable by a customer. `pnpm check:compliance-env` (Phase 6)
# fails the build if any REPLACE_ME survives into a production build.

PHARMACY_LEGAL_NAME="REPLACE_ME_LEGAL_NAME"
PHARMACY_TRADE_NAME="Ashirwad Medical"
PHARMACY_ADDRESS="REPLACE_ME_REGISTERED_PREMISES_ADDRESS, Nashik, Maharashtra"

# Drugs and Cosmetics Rules 1945 — retail licences. Form 20 covers non-Schedule-C
# drugs, Form 21 covers Schedule C/C(1). Both are issued against the premises.
PHARMACY_DL_NO_20B="REPLACE_ME_FORM_20B_LICENCE_NO"
PHARMACY_DL_NO_21B="REPLACE_ME_FORM_21B_LICENCE_NO"
PHARMACY_DL_ISSUING_AUTHORITY="REPLACE_ME_MAHARASHTRA_FDA_ZONE"

# FSSAI licence — required because the catalogue carries nutraceuticals and
# food supplements, not because it carries drugs.
PHARMACY_FSSAI_NO="REPLACE_ME_FSSAI_14_DIGIT_NO"

# Registered pharmacist under the Pharmacy Act 1948. This person's name and
# State Pharmacy Council registration number appear on the footer and on every
# Schedule H1 register entry they sign off.
PHARMACIST_NAME="REPLACE_ME_PHARMACIST_NAME"
PHARMACIST_REG_NO="REPLACE_ME_MSPC_REGISTRATION_NO"
PHARMACIST_COUNCIL="Maharashtra State Pharmacy Council"

PHARMACY_GSTIN="REPLACE_ME_GSTIN"
PHARMACY_SUPPORT_EMAIL="REPLACE_ME@example.invalid"
PHARMACY_SUPPORT_PHONE="REPLACE_ME_PHONE"

# --- Payments ---------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Cash-on-delivery is capped; orders above this must prepay.
COD_CEILING_PAISE="500000"

# --- Private object storage (prescriptions, health records) ------------------
# Bucket MUST be private. Reads are served only as short-lived signed URLs
# minted server-side. Never make this bucket public, and never expose the key.
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET_PRESCRIPTIONS=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SIGNED_URL_TTL_SECONDS="300"

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Ashirwad Wellness <noreply@example.invalid>"
