{
  "name": "Microns — C. Review Request & Response Drafting",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "treatment-completed",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Webhook: Treatment Completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-660, 240],
      "webhookId": "c3000000-0000-4000-8000-0000000000f1",
      "notes": "The backend POSTs here from /webhooks/treatment-completed. Body: { appointment_id, patient_uuid, service }."
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "days"
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Wait 5 Days",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [-440, 240],
      "webhookId": "c3000000-0000-4000-8000-0000000000f2",
      "notes": "n8n persists waits longer than 65s and resumes them after a restart. If you would rather not hold executions open for days, disable this branch and schedule the polling branch below instead."
    },
    {
      "parameters": {
        "jsCode": "// The webhook body arrives under `body` for webhook nodes.\nconst first = $input.first().json;\nconst payload = first.body || first;\n\nreturn [{\n  json: {\n    appointment_id: payload.appointment_id,\n    patient_uuid: payload.patient_uuid || null,\n    service: payload.service || null\n  }\n}];"
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Extract Appointment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 240]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MICRONS_API_URL }}/internal/reviews/status/{{ $json.appointment_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Check If Review Exists",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-no-review",
              "leftValue": "={{ $json.review_received }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "IF No Review Yet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/reviews/request",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "Send Review Request SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 140],
      "notes": "Copy: \"Hi [Name], hope you're loving your results! ... [Google Review Link]\" — rendered backend-side from CLINIC_REVIEW_URL."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/reviews/received",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id, rating: $json.rating || null, review_text: $json.review_text || null }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000007",
      "name": "Draft Response (OpenAI via backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 360],
      "notes": "The backend de-identifies the review text, calls gpt-4o, and returns a draft. Routing the model call through the backend is what keeps the OpenAI key and the audit record in one place."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL_REVIEWS || $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '*New review — draft reply needs approval*\\nRating: ' + ($json.data && $json.data.rating != null ? $json.data.rating : 'n/a') + '/5\\n\\n> ' + (($json.data && $json.data.draft_response) || '(no draft)') + '\\n\\nApprove and post it to your Google Business Profile if it reads right.' }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000008",
      "name": "Notify Clinic Manager for Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 360],
      "onError": "continueRegularOutput",
      "notes": "Set SLACK_WEBHOOK_URL in the n8n service environment. Configured to continue on error so an unset webhook does not fail the run."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mybusiness.googleapis.com/v4/REPLACE_WITH_ACCOUNT/locations/REPLACE_WITH_LOCATION/reviews/REPLACE_WITH_REVIEW/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GOOGLE_BUSINESS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ comment: $json.draft_response }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000009",
      "name": "Post Reply to Google Business Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 360],
      "disabled": true,
      "notes": "DISABLED ON PURPOSE. A public reply confirms the reviewer was a patient, so it must be a human decision. Enable only after wiring Google Business Profile OAuth and an explicit approval step."
    },
    {
      "parameters": {},
      "id": "c3000000-0000-4000-8000-00000000000a",
      "name": "End",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 140]
    }
  ],
