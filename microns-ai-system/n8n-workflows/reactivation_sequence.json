{
  "name": "Microns — B. No-Show Recovery & Reactivation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Daily at 10 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-620, 300],
      "notes": "Cron runs in the container timezone (GENERIC_TIMEZONE in docker-compose.yml)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/no-shows/detect",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "grace_hours",
              "value": "2"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Flag Missed Appointments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, 300],
      "notes": "Marks past-due active appointments as no_show so the fetch below has something to act on without front-desk data entry."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MICRONS_API_URL }}/api/appointments/no-shows",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "1"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Fetch Yesterday's No-Shows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "jsCode": "// One item per no-show. Every downstream node then runs once per item —\n// n8n's item model is the \"for each\" loop.\n// Anyone who already rebooked, or already got the text, is dropped here.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json;\n  const rows = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body]);\n\n  for (const row of rows) {\n    if (!row || !row.appointment_id) continue;\n    if (row.rebooked === true) continue;\n    if (row.reactivation_sent === true) continue;\n    out.push({ json: row });\n  }\n}\n\nreturn out;"
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Split: For Each No-Show",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/no-shows/reactivate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Send Reactivation SMS + Booking Link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "notes": "Backend renders the copy with the booking link, checks marketing consent, sends and logs 'reactivation_sent'."
    },
    {
      "parameters": {
        "jsCode": "// Fan back in to a single item so the next HTTP node fires once, not once\n// per no-show.\nreturn [{ json: { reactivations_attempted: $input.all().length } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MICRONS_API_URL }}/internal/no-shows/pending-credit",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "3"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Fetch 3-Day-Old No-Shows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "notes": "The '3 days later, still no rebooking?' branch. Implemented as a query on each daily run rather than a 3-day Wait node, so a restart cannot strand half the queue."
    },
    {
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json;\n  const rows = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body]);\n  for (const row of rows) {\n    if (row && row.appointment_id) out.push({ json: row });\n  }\n}\n\nreturn out;"
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Split: Still Not Rebooked",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/no-shows/credit-offer",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Send \"$50 Credit Expires Tomorrow\" SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 300],
      "notes": "Credit amount comes from NO_SHOW_CREDIT_AMOUNT in the backend .env."
    },
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-00000000000a",
      "name": "End",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1360, 300]
    }
  ],
  "connections": {
    "Daily at 10 AM": {
      "main": [
        [
          {
            "node": "Flag Missed Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Flag Missed Appointments": {
      "main": [
        [
          {
            "node": "Fetch Yesterday's No-Shows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Yesterday's No-Shows": {
      "main": [
        [
          {
            "node": "Split: For Each No-Show",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split: For Each No-Show": {
      "main": [
        [
          {
            "node": "Send Reactivation SMS + Booking Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Reactivation SMS + Booking Link": {
      "main": [
        [
          {
            "node": "Collect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect": {
      "main": [
        [
          {
            "node": "Fetch 3-Day-Old No-Shows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch 3-Day-Old No-Shows": {
      "main": [
        [
          {
            "node": "Split: Still Not Rebooked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split: Still Not Rebooked": {
      "main": [
        [
          {
            "node": "Send \"$50 Credit Expires Tomorrow\" SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send \"$50 Credit Expires Tomorrow\" SMS": {
      "main": [
        [
          {
            "node": "End",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true
  },
  "pinData": {},
  "tags": []
}
