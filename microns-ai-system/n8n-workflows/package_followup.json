{
  "name": "Microns — G. Package & Treatment-Plan Follow-Up",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "g7000000-0000-4000-8000-000000000001",
      "name": "Daily at 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-660, 260],
      "notes": "Cron runs in the container timezone (GENERIC_TIMEZONE in docker-compose.yml)."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MICRONS_API_URL }}/internal/packages/pending-followup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "g7000000-0000-4000-8000-000000000002",
      "name": "Fetch Patients Due For Follow-Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-440, 260],
      "notes": "Every service in PACKAGE_FOLLOWUP_DAYS (laser, botox, fillers, peel by default) has its own cadence — a patient six weeks out from a laser session is on schedule, not overdue. Already excludes anyone who rebooked or was already nudged for this session."
    },
    {
      "parameters": {
        "jsCode": "// One item per patient/service pair due a nudge. Downstream nodes then run\n// once per item.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json;\n  const rows = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body]);\n  for (const row of rows) {\n    if (row && row.appointment_id) out.push({ json: row });\n  }\n}\n\nreturn out;"
      },
      "id": "g7000000-0000-4000-8000-000000000003",
      "name": "Split: Due For Follow-Up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/packages/followup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id }) }}",
        "options": {}
      },
      "id": "g7000000-0000-4000-8000-000000000004",
      "name": "Send Rebooking Nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 260],
      "notes": "Marketing-consent gated, like reactivation and dormant-patient SMS — a rebooking nudge is not transactional."
    },
    {
      "parameters": {
        "jsCode": "// Fan back in to a single item so the Slack summary fires once, not once per patient.\nreturn [{ json: { nudges_sent: $input.all().length } }];"
      },
      "id": "g7000000-0000-4000-8000-000000000005",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-any",
              "leftValue": "={{ $json.nudges_sent }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "g7000000-0000-4000-8000-000000000006",
      "name": "IF Any Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL_RETENTION || $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':calendar: *Package follow-up run* — ' + $json.nudges_sent + ' rebooking nudge(s) sent for laser courses / injectable touch-ups due this run.' }) }}",
        "options": {}
      },
      "id": "g7000000-0000-4000-8000-000000000007",
      "name": "Notify Front Desk Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 160],
      "onError": "continueRegularOutput",
      "notes": "Set SLACK_WEBHOOK_URL_RETENTION (falls back to the shared SLACK_WEBHOOK_URL). Continues on error so an unset webhook does not fail the run."
    },
    {
      "parameters": {},
      "id": "g7000000-0000-4000-8000-000000000008",
      "name": "End",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, 260]
    }
  ],
  "connections": {
    "Daily at 9 AM": {
      "main": [
        [
          {
            "node": "Fetch Patients Due For Follow-Up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Patients Due For Follow-Up": {
      "main": [
        [
          {
            "node": "Split: Due For Follow-Up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split: Due For Follow-Up": {
      "main": [
        [
          {
            "node": "Send Rebooking Nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Rebooking Nudge": {
      "main": [
        [
          {
            "node": "Collect",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect": {
      "main": [
        [
          {
            "node": "IF Any Sent?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Any Sent?": {
      "main": [
        [
          {
            "node": "Notify Front Desk Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "End",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Front Desk Summary": {
      "main": [
        [
          {
            "node": "End",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true
  },
  "pinData": {},
  "tags": []
}
