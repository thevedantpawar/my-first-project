{
  "name": "Microns — A. No-Show Prevention",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MICRONS_API_URL }}/api/appointments/upcoming",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "within_hours",
              "value": "48"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Fetch Upcoming Appointments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Normalise the response into one item per appointment and compute the\n// time delta. The backend already returns hours_until and the due_* flags;\n// recomputing here keeps the workflow readable and survives clock skew\n// between the n8n container and the API.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json;\n  const rows = Array.isArray(body) ? body : (Array.isArray(body.data) ? body.data : [body]);\n\n  for (const row of rows) {\n    if (!row || !row.appointment_id) continue;\n\n    const scheduledFor = new Date(row.scheduled_for);\n    const hoursUntil = (scheduledFor.getTime() - Date.now()) / 3600000;\n\n    out.push({\n      json: {\n        ...row,\n        hours_until: Math.round(hoursUntil * 100) / 100,\n        // Windows are wider than a single hour so an hourly cron cannot miss\n        // one, and the backend de-duplicates repeat sends.\n        due_24h_reminder: row.due_24h_reminder === true || (hoursUntil >= 20 && hoursUntil <= 28 && row.reminder_24h_sent !== true),\n        due_2h_reminder: row.due_2h_reminder === true || (hoursUntil >= 1 && hoursUntil <= 3 && row.reminder_2h_sent !== true)\n      }\n    });\n  }\n}\n\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Calculate Time Delta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-24h",
              "leftValue": "={{ $json.due_24h_reminder }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "IF 24 Hours Before?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MICRONS_API_URL }}/internal/reminders/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id, kind: '24h' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Send 24h Reminder SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 140],
      "notes": "The backend renders the copy, checks consent, sends via Twilio and writes the audit row. n8n never sees the patient's phone number."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-2h",
              "leftValue": "={{ $json.due_2h_reminder }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "IF 2 Hours Before?",
