        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointment_id: $json.appointment_id, kind: '2h' }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Send 2h Reminder SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
