# =============================================================================
# Microns AI System — environment configuration
#
#   cp .env.example .env
#   docker compose run --rm backend python -m app.cli gen-key   # ENCRYPTION_KEY
#   docker compose up
#
# NEVER commit a real .env. It holds the key that decrypts all PHI.
# =============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://microns:password@postgres:5432/microns_db
POSTGRES_USER=microns
POSTGRES_PASSWORD=password
POSTGRES_DB=microns_db

# 32-byte urlsafe-base64 Fernet key. Generate with either:
#   docker compose run --rm backend python -m app.cli gen-key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means losing every encrypted PHI field. Back it up in a
# secrets manager (AWS Secrets Manager / Vault), never in git.
ENCRYPTION_KEY=generate-with-fernet-key-gen

# Comma-separated retired keys. Decrypt-only, used for zero-downtime key
# rotation: put the new key in ENCRYPTION_KEY, move the old one here.
ENCRYPTION_KEYS_OLD=

# Separate secret used to build deterministic lookup fingerprints (HMAC-SHA256)
# for phone/email, so records can be found without decrypting the whole table.
FINGERPRINT_SECRET=change-me-to-a-long-random-string

# Shared secret n8n uses to call internal backend endpoints.
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# Shared secret for clinic-staff endpoints (retention dashboard, at-risk list).
# Sent as the X-Staff-Token header. Replace with your IdP in a multi-user
# deployment so the audit trail attributes access to a real person.
STAFF_API_TOKEN=

# --- OpenAI -----------------------------------------------------------------
# BAA REQUIRED. Before any PHI-adjacent traffic: sign a Business Associate
# Agreement with OpenAI and have Zero Data Retention enabled on the org
# (support@openai.com). ZDR endpoints do not persist prompts or completions.
# Independently of ZDR, every prompt this system sends is de-identified first
# (app/services/deidentify.py) — belt and braces.
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
# Set false ONLY in a non-PHI sandbox. When true the client sends store=false
# on every request and refuses to start if the API key looks like a shared one.
OPENAI_ZERO_RETENTION=true

# --- Twilio -----------------------------------------------------------------
# BAA REQUIRED for SMS that contains appointment details. Twilio signs a BAA
# for Programmable SMS/Voice; enable it before go-live and keep message bodies
# minimal (no diagnoses, no treatment details).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
# Twilio validates inbound webhooks with this. Leave true in production.
TWILIO_VALIDATE_SIGNATURE=true
# Allow SMS copy to name the treatment ("your Botox appointment"). Off by
# default: texts appear on lock screens. Turn on only with clinic sign-off.
SMS_INCLUDE_TREATMENT_DETAILS=false

# --- VAPI (voice agent) -----------------------------------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Number the agent transfers to for clinical questions it must not answer.
CLINIC_TRANSFER_NUMBER=+1...

# --- Booking system (generic adapter) ---------------------------------------
# acuity | square | mindbody | generic
# `generic` uses the built-in PostgreSQL-backed scheduler, which is what runs
# out of the box with no third-party credentials.
BOOKING_SYSTEM_TYPE=generic
BOOKING_API_KEY=
BOOKING_API_SECRET=
BOOKING_API_BASE_URL=
BOOKING_CALENDAR_ID=

# --- Calendly (hot-lead auto-booking) ---------------------------------------
CALENDLY_API_KEY=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_SCHEDULING_URL=https://calendly.com/your-clinic/consultation

# --- n8n --------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_HOST=localhost
N8N_PORT=5678
# Optional: incoming-webhook URL for staff notifications from the workflows.
# Workflow nodes are set to continue on error, so leaving this blank is safe.
SLACK_WEBHOOK_URL=
# Where the backend fires workflow triggers. Use the /webhook-test variant
# while you are building a workflow in the n8n editor.
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook

# --- Clinic profile (used in SMS copy and voice prompts) --------------------
CLINIC_NAME=Radiance Med Spa
CLINIC_TIMEZONE=America/New_York
CLINIC_PHONE=+1...
CLINIC_BOOKING_URL=https://your-clinic.com/book
CLINIC_REVIEW_URL=https://g.page/r/your-google-review-link/review
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18

# --- Retention tuning -------------------------------------------------------
# Applied by the n8n cron workflows; see n8n-workflows/README.md.
REACTIVATION_DAYS=45
REVIEW_REQUEST_DELAY_DAYS=5
NO_SHOW_CREDIT_AMOUNT=50

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call /leads/chat from the browser widget.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated hostnames the API will answer to in production.
ALLOWED_HOSTS=*
REDIS_URL=redis://redis:6379/0
